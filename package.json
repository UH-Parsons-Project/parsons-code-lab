{
	"name": "faded-parsons-static",
	"repository": "https://github.com/pamelafox/faded-parsons-static",
	"license": "Apache-2.0",
	"private": true,
	"devDependencies": {
		"@babel/core": "^7.11.0",
		"@babel/eslint-parser": "^7.17.0",
		"@playwright/test": "^1.59.0",
		"@rollup/plugin-node-resolve": "^11.1.0",
		"@types/node": "^25.1.0",
		"dotenv": "^17.4.2",
		"eslint": "^8.15.0",
		"flatted": ">=3.4.2",
		"husky": "^8.0.1",
		"lint-staged": "^13.0.3",
		"lit-analyzer": "^2.0.3",
		"npm-run-all": "^4.1.5",
		"prettier": "^2.6.2",
		"rollup": "^2.80.0",
		"rollup-plugin-copy": "^3.4.0",
		"rollup-plugin-terser": "^7.0.2"
	},
	"dependencies": {
		"jquery": "^3.6.0",
		"jquery-ui": "^1.13.2",
		"js-yaml": "^4.3.2",
		"lit": "^2.2.4"
	},
	"overrides": {
		"minimatch": ">=3.1.3",
		"picomatch": ">=2.3.2 <3",
		"flatted": ">=3.4.2",
		"serialize-javascript": ">=7.0.5"
	},
	"scripts": {
		"lint": "npm run lint:lit-analyzer && npm run lint:eslint",
		"lint:eslint": "eslint 'js/**/*.js' 'js-parsons/**/*.js'",
		"lint:lit-analyzer": "lit-analyzer 'js/**/*-element.js'",
		"test:all": "./scripts/run-all-tests.sh",
		"format": "prettier \"**/*.{js,json}\" --ignore-path ./.eslintignore --write",
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"dev": "npm-run-all --parallel start watch",
		"start": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
		"prod": "uvicorn backend.main:app --host 0.0.0.0 --port 8000",
		"prepare": "test -d .git && husky install || true"
	},
	"lint-staged": {
		"js/**/*-element.js": "lit-analyzer",
		"*.js": "eslint --cache --fix",
		"*.--write": "prettier \"**/*.{js,json}\" --ignore-path ./.eslintignore --write"
	}
}
